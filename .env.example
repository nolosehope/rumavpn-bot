# ===== Скопируйте этот файл как .env и заполните =====

# Токен бота от @BotFather
BOT_TOKEN=

# ID чата, куда будут приходить заявки (группа админов или ваш личный чат с ботом).
# Узнать ID: напишите боту /id в нужном чате
ADMIN_CHAT_ID=

# Реквизиты для оплаты. Перенос строки = \n
PAYMENT_REQUISITES=💳 Карта: 2200 0000 0000 0000\n🏦 Банк: Т-Банк\n👥 Получатель: Иван И.

# Ссылка, куда ведёт кнопка «Оставить отзыв»
REVIEW_URL=https://t.me/ваш_канал

# Ссылка кнопки «Поддержка»
SUPPORT_URL=https://t.me/ваш_юзернейм

# Ссылка на мини-приложение (например https://ВАШ_ЛОГИН.github.io/rumavpn-webapp)
WEBAPP_URL=

# Прокси для Telegram API (если провайдер блокирует Telegram), например socks5://127.0.0.1:10808
PROXY_URL=
